PYTHONPATH=.

ENVIRONMENT=development
AI_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Admin stays disabled unless all three values are configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=
ADMIN_SESSION_SECRET=

# ── Gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key


# ── PostgreSQL (same cluster as C# backend) ───────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── Legacy: used only by menu_service (supabase) ──────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
